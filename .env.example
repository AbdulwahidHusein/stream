# Copy to `.env.local` for `pnpm dev`. Never commit a filled-in copy.
#
# Where each runtime reads its values from:
#
#   pnpm dev        .env.local                    (Next loads it; git-ignored)
#   pnpm preview    .dev.vars                     (workerd; git-ignored)
#   pnpm deploy     wrangler secret put NAME      (encrypted, per Worker)
#                   or `vars` in wrangler.jsonc   (plain text, commit-visible)
#
# Rule of thumb for the deployed Worker: anything marked SECRET below goes
# through `wrangler secret put` and never into wrangler.jsonc, which is a
# committed file. Everything else is safe as a plain `vars` entry.
#
# ── Required to sign in ─────────────────────────────────────────────────────

# Origin the app is served from, and the base of the OAuth redirect URI.
# Wrong value ⇒ Google returns redirect_uri_mismatch, which explains nothing.
# Unset ⇒ each request falls back to its own Host header, which is fine locally
# and wrong behind any proxy.
APP_URL=http://localhost:3000

# Google Cloud Console → APIs & Services → Credentials → OAuth client ID →
# Web application. Add one authorized redirect URI per origin you run on, matched
# byte for byte:
#   http://localhost:3000/api/auth/callback/google     (pnpm dev)
#   http://localhost:8787/api/auth/callback/google     (pnpm preview)
#   https://stream.et/api/auth/callback/google         (deployed)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=          # SECRET

# ── Required in production ──────────────────────────────────────────────────

# SECRET. Salt for the §8.4 viewer-key hash in lib/views.ts — *not* a session
# secret; sessions are opaque random tokens stored hashed in D1 and sign nothing.
# Unset, it falls back to a public constant, which makes the "one view per viewer
# per day" hashes reproducible by anyone holding an IP and user-agent.
SESSION_SECRET=replace-with-long-random-string

# ── Optional: limits and cost controls (§6.1) ───────────────────────────────
# Defaults live in lib/plans.ts; set these only to override.

MAX_FREE_POOL_BYTES=8589934592
MAX_STORAGE_BYTES_INDIVIDUAL=10737418240

# Read by lib/plans.ts today even though billing itself (§12) is unbuilt — they
# feed the price shown to users, not any charge.
INDIVIDUAL_PRICE_ETB=300
BILLING_GRACE_DAYS=3

# ── Not wired yet — listed so the eventual names are not a surprise ─────────
# Nothing reads these. Billing providers (§12), magic links (§7.1), presigned R2
# URLs (§10.5), and the abuse endpoint (§14.1) are all still unbuilt. Bitrates
# and the free link TTL are deliberately absent: they are compile-time constants
# in lib/plans.ts, the single source of truth §13 asks for.

WEBIRR_API_KEY=
WEBIRR_WEBHOOK_SECRET=
RESEND_API_KEY=
EMAIL_FROM=noreply@stream.et
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=stream-videos
R2_PUBLIC_BASE_URL=
ABUSE_CONTACT_EMAIL=abuse@stream.et
