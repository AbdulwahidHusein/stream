# App
APP_URL=http://localhost:3000
SESSION_SECRET=replace-with-long-random-string

# Email (magic links)
RESEND_API_KEY=
EMAIL_FROM=noreply@stream.et

# R2 (local / S3-compatible API — production uses wrangler bindings)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=stream-videos
R2_PUBLIC_BASE_URL=

# Billing
WEBIRR_API_KEY=
WEBIRR_WEBHOOK_SECRET=
INDIVIDUAL_PRICE_ETB=300
BILLING_GRACE_DAYS=3

# Limits / cost controls (TECHNICAL_SPEC §6.1)
VIDEO_BITRATE_BPS=1500000
AUDIO_BITRATE_BPS=96000
MAX_FREE_POOL_BYTES=8589934592
MAX_STORAGE_BYTES_INDIVIDUAL=10737418240
FREE_LINK_TTL_DAYS=7

# Abuse
